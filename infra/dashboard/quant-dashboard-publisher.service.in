[Unit]
Description=Quant Dashboard isolated read-only trading observer
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=quant-dashboard-publisher
Group=quant-dashboard-read
SupplementaryGroups=quant-dashboard-web
ExecStart=/opt/quant-dashboard/current/bin/dashboard_publish_cli --source-dir @SOURCE_DIR@ --identity-file /etc/quant-dashboard/identity.json --output-dir /var/lib/quant-dashboard-public/data/v1 --state-dir /var/lib/quant-dashboard-publisher --watch-seconds 1 --retention-days 90
StateDirectory=quant-dashboard-publisher
StateDirectoryMode=0700
ReadWritePaths=/var/lib/quant-dashboard-public
ReadOnlyPaths=@SOURCE_DIR@
BindReadOnlyPaths=@SOURCE_DIR@
UMask=0027
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=tmpfs
PrivateTmp=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
CPUQuota=25%
MemoryHigh=128M
MemoryMax=256M
Nice=10
IOWeight=10
TasksMax=32

[Install]
WantedBy=multi-user.target
