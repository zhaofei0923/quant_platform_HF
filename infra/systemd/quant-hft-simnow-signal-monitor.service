[Unit]
Description=Quant HFT SimNow Full Pipeline Health Monitor (user unit)
After=network-online.target quant-hft-simnow-trading.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/workspace/quant_platform_HF
Environment=QUANT_HFT_ENV=simnow
Environment=QUANT_ROOT=%h/workspace/quant_platform_HF
EnvironmentFile=-/etc/quant/platform.conf
# Paths use the same account identity/environment as core_engine; never pin old shared state.
ExecStart=/bin/bash -lc ': "${QUANT_ROOT:?QUANT_ROOT is required}"; exec "${QUANT_ROOT}/scripts/ops/monitor_simnow_signal_execution.sh" --trading-sessions-config "${QUANT_ROOT}/configs/trading_sessions.yaml"'
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
